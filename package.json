{
  "name": "ifakepro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native chord chart reader, editor and accompaniment player. Imports iReal Pro playlists.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "fixtures:fetch": "node tools/fetch-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.18"
  }
}
